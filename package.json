{
  "name": "@pug-sh/browser",
  "version": "0.1.0",
  "description": "Pug browser SDK for event tracking and product analytics",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "jsdelivr": "./dist/cdn/pug.min.js",
  "unpkg": "./dist/cdn/pug.min.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "WELL_KNOWN_EVENTS.md",
    "LICENSE"
  ],
  "homepage": "https://pug.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pug-sh/sdk-browser.git"
  },
  "bugs": {
    "url": "https://github.com/pug-sh/sdk-browser/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "echo \"export const SDK_VERSION = '$(bun --print \"require('./package.json').version\")'\" > src/version.ts",
    "build": "rm -rf dist && bun --bun tsc && bun scripts/build-cdn.mjs",
    "prepare": "bun run build",
    "prepublishOnly": "make check-proto-pin && bun run build",
    "publish:dist": "bun run scripts/publish-dist-branch.mjs",
    "watch": "bun --bun tsc -w",
    "dev": "bun --bun tsc -w & bun --bun serve . & sleep 1 && open http://localhost:3000 && wait",
    "serve": "bun --bun serve . & sleep 1 && open http://localhost:3000 && wait",
    "typecheck": "bun --bun tsc -p tsconfig.typecheck.json",
    "lint": "bun --bun biome check --write .",
    "format": "bun --bun biome format --write .",
    "test": "bun --bun vitest run",
    "test:watch": "bun --bun vitest"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.0",
    "uuidv7": "^1.1.0"
  },
  "keywords": [
    "analytics",
    "tracking",
    "events",
    "sdk",
    "browser",
    "web"
  ],
  "author": "pug.sh",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@bufbuild/protoc-gen-es": "^2.12.1",
    "esbuild": "0.28.2",
    "jsdom": "^30.0.1",
    "serve": "^14.2.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  }
}
