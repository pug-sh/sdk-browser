{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    // Declared so the CDN bundle's entry point isn't reachable only via cdn.test.ts.
    "src/cdn.ts",
    // Makefile-invoked. Listed one by one on purpose: a `scripts/*.mjs` glob would also mark
    // legal.mjs and publish-cdn.lib.mjs as entries, exempting their exports from the gate.
    "scripts/gen-well-known-events.mjs",
    "scripts/strip-validate-deps.mjs"
  ],
  "project": ["src/**/*.ts", "scripts/**/*.mjs"],
  "ignore": ["src/gen/**"],
  // `make check-proto-pin` runs from prepublishOnly.
  "ignoreBinaries": ["make"],
  // knip doesn't resolve binaries invoked through `bun` (`bunx` and bare binaries resolve fine),
  // so it misses the `bun --bun biome` in package.json's scripts.
  "ignoreDependencies": ["@biomejs/biome"]
}
